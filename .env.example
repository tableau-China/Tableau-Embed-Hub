# =============================================================================
# 复制本文件为 .env 即接入你自己的 Tableau 站点（.env 已被 .gitignore 排除，勿提交）
#
# 三步走（详见 docs/tableau-setup.md）：
#   1) 填 ① 站点绑定     —— 填完就能连上你的站点
#   2) 填 ② 凭据         —— Tableau Cloud → 设置 → 已连接应用，创建后拿 clientId/secretId/secretValue
#   3) 在 Connected App 里把「本站域名」加进白名单，否则嵌入会被拒
#
# 不填任何一项也能跑：应用会使用内置的**演示站点 + 演示凭据**（仅供演示，不要用于生产）。
# 应用内 /help 页有「环境自检」卡片，会告诉你当前用的是演示值还是你自己的值。
#
# ⚠️ 这些变量在**构建时**内联进 JS bundle，纯前端无法真正保密（凭据详见 docs/tableau-setup.md）。
# ⚠️ 变量名必须逐项写全并保持静态引用；改了 .env 需要重新构建。
# =============================================================================

# ---------- ① 站点绑定 ----------
# 站点地址（Tableau Cloud 站点 URL 的协议 + 主机部分）
VITE_TABLEAU_SERVER_URL=https://10ax.online.tableau.com
# 站点显示名（后台 Site name）
VITE_TABLEAU_SITE_NAME=your_site_name
# 站点内容 URL（浏览器地址 /t/<这一段>/ 的值）
VITE_TABLEAU_SITE_CONTENT_URL=your_site_content_url
# 签名用的嵌入用户（Connected App 的 embed user）
VITE_TABLEAU_EMBED_USER=embed-user@example.com
# 只显示某个项目（留空 = 显示全部；置空可避免"只看到很少工作簿"的困惑）
VITE_TABLEAU_PROJECT=
# REST API 版本（Tableau 每年发版数次，报 404/版本错误时改这里）
VITE_TABLEAU_API_VERSION=3.23
# REST 同源代理路径前缀（改了这里，生产网关也要配同一路径，见 deploy/nginx.conf.example）
VITE_TABLEAU_API_BASE=/tableau-proxy

# ---------- ② Connected App 凭据 ----------
# Tableau Cloud → 设置 → 已连接应用 → 新建，创建后立即保存（secretValue 只显示一次）
VITE_TABLEAU_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_TABLEAU_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_TABLEAU_SECRET_VALUE=base64-encoded-secret-value

# ---------- ③ AI 能力（可选） ----------
# 留空 VITE_AI_PROXY_URL = 使用内置**演示 provider**（本地流式输出，不发任何请求，零配置可看效果）。
# 接真实模型：自己起一个同源网关，实现 OpenAI 兼容的 POST /chat/completions（stream: true），
# 然后把下面两项指向它。**厂商 API Key 只能放网关里**，绝不能写进本文件 —— 本文件的内容会内联进 bundle。
# 契约与样例（nginx + 约 30 行 Node）：docs/ai-integration.md
VITE_AI_PROXY_URL=
# 模型名（透传给上游；DeepSeek 默认 deepseek-chat）
VITE_AI_MODEL=deepseek-chat
# 可选：系统提示词（不填则用模板内置的默认值）
# VITE_AI_SYSTEM_PROMPT=You are a helpful assistant.
