# 可选覆盖文件：复制为 .env 并填入自有 Tableau Connected App 凭据（.env 已被 gitignore，勿提交）
# 不配置时，应用自动使用内置的混淆开发凭据（开箱即用，仅供开发演示）。
# 凭据获取：Tableau Cloud → 已连接应用 → 应用详情页
VITE_TABLEAU_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_TABLEAU_SECRET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_TABLEAU_SECRET_VALUE=base64-encoded-secret-value
