{
  "name": "shadcn-admin-cn",
  "private": true,
  "version": "0.10.0",
  "packageManager": "pnpm@11.28.2",
  "type": "module",
  "description": "基于 shadcn/ui + Tailwind CSS v4 + Radix UI 构建的管理后台模板（当前仅英文，后续扩展多语言）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:routes": "node scripts/check-route-catalog.mjs",
    "check:team-routes": "node scripts/check-team-routes.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:filters": "node scripts/check-filters.mjs",
    "check:smtp": "node scripts/check-smtp.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tableau/embedding-api": "^3.16.1",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.1.0-dev.20260930.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
